# Copy to .env.local (dev) or set in Vercel (prod).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Discord OAuth (create an app at https://discord.com/developers/applications).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Where Discord redirects after login. In dev: http://localhost:3000/api/auth/callback
DISCORD_REDIRECT_URI=

# Comma-separated Discord user IDs allowed to view the dashboard (Lords).
DASHBOARD_ADMIN_IDS=

# Long random string used to sign session cookies.
SESSION_SECRET=
